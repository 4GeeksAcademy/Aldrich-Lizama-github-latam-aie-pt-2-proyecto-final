# ────────────────────────────────────────────
# Nexova API — Variables de Entorno
# ────────────────────────────────────────────
# Copia este archivo como .env y completa los valores:
#   cp .env.example .env
# ────────────────────────────────────────────

# Secreto para firmar los tokens JWT.
# En producción, generar con: openssl rand -hex 32
SECRET_KEY="changeme-please-use-a-secure-random-key"

# Algoritmo de firma para JWT
ALGORITHM="HS256"

# Tiempo de expiración del token de acceso en minutos
ACCESS_TOKEN_EXPIRE_MINUTES=60
# ── Servicio de correo electrónico (Resend / SendGrid) ──
# Clave API del servicio de correos transaccionales.
EMAIL_SERVICE_API_KEY="re_123456789"

# Dirección remitente verificada en el servicio de correos.
EMAIL_FROM="onboarding@resend.dev"

# URL base del frontend para enlaces en correos.
FRONTEND_URL="http://localhost:3000"

# Tiempo de expiración del token de restablecimiento en minutos
RESET_TOKEN_EXPIRE_MINUTES=30
